                                                        @php
                                                            $role = $user->role ?? 'Member';
                                                            $roleBadgeClass = 'bg-secondary';
                                                            $roleIcon = 'fas fa-user';
                                                            if ($role === 'Leader') {
                                                                $roleBadgeClass = 'bg-success';
