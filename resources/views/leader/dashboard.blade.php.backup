        opacity: 1 !important;
        overflow: visible !important;
        min-width: 150px !important;
    }

    /* Table-enhanced column widths for horizontal scrolling */
    .table-enhanced .table-header-cell:nth-child(1),
    .table-enhanced .modern-header-cell:nth-child(1),
