                                        <div class="card-header bg-white border-0 py-2">
                                            <h6 class="text-primary mb-0">
                                                <i class="fas fa-user me-2"></i>
                                                Basic Information
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-12">
